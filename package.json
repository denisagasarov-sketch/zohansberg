{
  "name": "focus-board",
  "version": "0.1.0",
  "main": "electron/main.js",
  "scripts": {
    "tauri": "tauri",
    "electron:dev": "electron .",
    "electron:build": "electron-builder --mac",
    "dev": "tauri dev",
    "build": "tauri build"
  },
  "build": {
    "appId": "com.focusboard.app",
    "productName": "Focus Board",
    "asar": false,
    "mac": {
      "icon": "electron/icon.png",
      "category": "public.app-category.productivity"
    },
    "files": [
      "electron/**/*",
      "backend/**/*",
      "frontend/dist/**/*",
      "node_modules/**/*"
    ]
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "sharp": "^0.33.5"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "node-fetch": "^3.3.2"
  }
}
