# ─────────────────────────────────────────────────────────────────────────────
# Конфигурация Instagram Competitor Research Pipeline
# Скопируйте этот файл в .env и заполните значения:
#   cp .env.example .env
# Файл .env в git не попадает (см. .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# ── Telegram-бот ─────────────────────────────────────────────────────────────
# Токен бота от @BotFather (создать бота: /newbot → скопировать токен)
TELEGRAM_BOT_TOKEN=

# ID чатов, которым разрешён доступ к боту, через запятую.
# Свой ID можно узнать: написать боту /start — он покажет ваш chat_id.
TELEGRAM_ALLOWED_IDS=

# ── OpenAI (анализ текста/визуала через GPT) ─────────────────────────────────
# Ключ из https://platform.openai.com/api-keys (формат sk-...)
OPENAI_API_KEY=

# ── Apify (сбор данных Instagram через actors) ───────────────────────────────
# Токен из https://console.apify.com/settings/integrations
APIFY_TOKEN=

# ── Instagram session cookie (нужен для сбора сторис, стейдж 09) ──────────────
# Залогиниться в Instagram в браузере → DevTools → Application → Cookies →
# скопировать значение всей строки cookie (или sessionid). Куки протухают —
# при ошибках стейджа 09 обновить значение.
INSTAGRAM_SESSION_COOKIE=

# ── Google Sheets (запись результатов) ───────────────────────────────────────
# URL развёрнутого Apps Script Web App (Deploy → New deployment → Web app →
# скопировать /exec URL). Скрипт: apps_script/stage5d3_write_google_sheets_webapp.gs
GOOGLE_SHEETS_WEBAPP_URL=

# Секрет, заданный в Apps Script (Project Settings → Script Properties →
# SYNC_SECRET). Должен совпадать со значением в скрипте.
GOOGLE_SHEETS_SYNC_SECRET=

# ID Google-таблицы (из URL: docs.google.com/spreadsheets/d/<ЭТОТ_ID>/edit)
GOOGLE_SHEETS_SPREADSHEET_ID=1xXyd9B_OmAD48tTSY3K82cv5YKUEMwBmKLFUPcTqDzQ
